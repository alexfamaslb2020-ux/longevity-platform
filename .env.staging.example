# =============================================================================
# Longevity Platform — Staging Environment Configuration
# =============================================================================
# Copy this file to .env.staging and fill in the values.
# cp .env.staging.example .env.staging
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=staging
API_PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=https://staging.longevity.pt
NEXT_PUBLIC_API_URL=https://staging.longevity.pt/api/v1

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Separate database for staging — never reuse dev or test databases.
# Credentials must differ from development and production.
DATABASE_URL=postgresql://longevity_staging:CHANGE_ME_STRONG_PASSWORD@postgres:5432/longevity_staging?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars-for-staging
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string-for-staging

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://staging.longevity.pt
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Providers (Mock — no real external services) ─────────────────────────────
WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock
MESSAGING_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_VOICE_AI=false
FEATURE_CLIENT_PORTAL=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Sentry (Error Tracking) ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# ── Observability ────────────────────────────────────────────────────────────
METRICS_ENABLED=true

# ── External Services (Leave empty — mock providers are used) ────────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_SECRET=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
RESEND_API_KEY=
EMAIL_FROM=noreply@staging.longevity.pt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=longevity-staging
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
