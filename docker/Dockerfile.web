FROM node:22-bullseye-slim AS development

RUN apt-get update -qq && apt-get install -y -qq wget ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json turbo.json ./
COPY apps/web/package*.json apps/web/tsconfig*.json apps/web/next.config.* apps/web/tailwind.config.ts apps/web/postcss.config.js ./apps/web/
COPY packages/shared/package*.json packages/shared/tsconfig*.json ./packages/shared/

RUN npm install --no-package-lock

COPY apps/web/src ./apps/web/src
COPY apps/web/public ./apps/web/public
COPY packages/shared/src ./packages/shared/src

EXPOSE 3000

CMD ["npm", "run", "dev"]

FROM node:22-bullseye-slim AS production

WORKDIR /app

COPY package*.json turbo.json ./
COPY apps/web/package*.json apps/web/tsconfig*.json apps/web/next.config.* apps/web/tailwind.config.ts apps/web/postcss.config.js ./apps/web/
COPY packages/shared/package*.json packages/shared/tsconfig*.json ./packages/shared/

RUN npm install --no-package-lock

COPY apps/web/src ./apps/web/src
COPY apps/web/public ./apps/web/public
COPY packages/shared/src ./packages/shared/src

RUN cd apps/web && npm run build

EXPOSE 3000

CMD ["npm", "start"]
