# =============================================================================
# Longevity Platform — Demo Environment (local only)
# =============================================================================
# All values are defaults for local demo. No secrets needed.
# Copy to .env.demo if you want to override any value.
# cp .env.demo.example .env.demo
# =============================================================================

NODE_ENV=demo
API_PORT=3001
API_PREFIX=/api/v1
NEXT_PUBLIC_API_URL=/api/v1

DATABASE_URL=postgresql://longevity_demo:demo_password@postgres:5432/longevity_demo?schema=public
REDIS_URL=redis://redis:6379/0

JWT_SECRET=demo-jwt-secret-at-least-32-chars-long!!
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

ENCRYPTION_KEY=demo-32-byte-hex-string-for-encryption

CORS_ORIGIN=*

WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock
MESSAGING_PROVIDER=mock
PAYMENT_PROVIDER=mock

FEATURE_VOICE_AI=false
FEATURE_CLIENT_PORTAL=false

LOG_LEVEL=info
LOG_FORMAT=json

# Dify (opcional) — sem DIFY_API_KEY o atendimento usa regras locais.
# Se tiveres o Dify a correr no Docker Desktop, define a chave da app aqui.
DIFY_API_BASE_URL=http://host.docker.internal:80/v1
DIFY_API_KEY=
DIFY_TIMEOUT_MS=120000

# RAG / AI Assistant — embeddings locais determinísticos (0 dependências).
# provider alternativo: ollama (RAG_EMBEDDING_PROVIDER=ollama)
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_DIMENSIONS=384
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.32
RAG_CHUNK_MAX_CHARS=700
RAG_CHUNK_OVERLAP=80
