# Database
DATABASE_URL=postgresql://longevity:longevity@localhost:5432/longevity?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# MFA
MFA_ISSUER=LongevityPlatform

# API
API_PORT=3001
API_PREFIX=/api/v1
NODE_ENV=development

# WhatsApp
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_SECRET=

# Voice AI (Vapi)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# OpenAI / LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o

# Dify (AI platform — chat & workflows)
DIFY_API_BASE_URL=http://host.docker.internal:80/v1
DIFY_API_KEY=
DIFY_TIMEOUT_MS=30000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@longevity.pt

# Calendar (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=longevity-platform

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry
SENTRY_DSN=

# Feature Flags
FEATURE_VOICE_AI=false
FEATURE_CLIENT_PORTAL=false
